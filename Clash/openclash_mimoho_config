#在订阅管理中，直接编辑，然后 保存配置 ➡ 应用配置，也可以在openclash覆写设置中修改。
#openclash覆写设置 - meta设置，勾选启动 tcp 并发、统一延迟，开启域名嗅探。DNS监听端口号已改为7874
#⚠️字段拷贝进openclash修改配置后，注意检查首页的运行配置对不对，遇到过nameserver-policy没生效，openclash自动补了fallback的情况。。。。
#在规则附加中，可以添加自定义规则，支持yaml和txt规则格式，具体规则在 https://github.com/blackmatrix7/ios_rule_script/tree/master/rule 取需
#fallback中科普了dns服务器类型，记录了常用加密dns
#mimoho 快捷配置 https://wiki.metacubex.one/example/conf 有两种分流形式，GeoX (geosite/geoip) → 依赖数据库，Rule-Set (远程规则集) → 拉远程订阅，可混合使用

geodata-mode: true
#自定义 geodata url
geox-url:
  geoip: "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/v2fly/domain-list-community@release/dlc.dat"
  # geosite: "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.metadb"
geo-auto-update: true
geo-update-interval: 24

sniffer:
  enable: true
  override-destination: true # 是否使用嗅探结果作为实际访问，默认 true
  sniff:
    # HTTP:
    #   ports: [80, 8080-8880]
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]
  force-domain:
    - "+.netflix.com"
    - "+.nflxvideo.net"
    - "+.amazonaws.com"
    - "+.media.dssott.com"
  # skip-src-address: # 对于来源ip跳过嗅探
  #   - 192.168.0.3/32
  skip-dst-address: # 对于目标ip跳过嗅探
    - 192.168.2.0/24      
  skip-domain:
    - "Mijia Cloud"
    - "+.push.apple.com"

dns:
  cache-algorithm: arc
  enable: true # 关闭将使用系统 DNS
  listen: 0.0.0.0:7874 # 开启 DNS 服务器监听
  ipv6: false # false 将返回 AAAA 的空结果
  # 用于解析 nameserver，fallback 以及其他 DNS 服务器配置的，DNS 服务域名
  # 只能使用纯 IP 地址，可使用加密 DNS
  default-nameserver:
    - 114.114.114.114 # 南京信风
    - 8.8.8.8
    - tls://1.12.12.12:853 # 腾讯 DoT
    - tls://223.5.5.5:853
    - system # append DNS server from system configuration. If not found, it would print an error log and skip.
  enhanced-mode: redir-host # or fake-ip
  
  fake-ip-range: 198.18.0.1/16 # fake-ip 池设置
  
  # fakeip 过滤，以下域名解析不采用 fake-ip 方式，这些域名相关的解析请求将会返回它们真实的 IP 地址
  fake-ip-filter:
     - "*.lan"
     - localhost.ptlogin2.qq.com
     - +.srv.nintendo.net
     - +.stun.playstation.net
     - +.msftconnecttest.com
     - +.msftncsi.com
     - +.xboxlive.com
     - msftconnecttest.com
     - xbox.*.microsoft.com
     - "*.battlenet.com.cn"
     - "*.battlenet.com"
     - "*.blzstatic.cn"
     - "*.battle.net"   
     
  nameserver: # 默认 DNS 服务
     - system
     - 223.5.5.5
     - 119.29.29.29

  # fallback: # 国外 DNS 服务器
  #    - tls://1.1.1.1:853 # DoT，简单高效，易被识别封锁；而DoH 隐蔽性强，不易封锁，延迟略高
  #    - https://1.1.1.1/dns-query # IP DoH，不依赖本地 DNS 解析，直连更干净，免污染
  #    - https://cloudflare-dns.com/dns-query # 域名 DoH，动态调度，跨地区性能好
  #    - tls://8.8.8.8:853
  #    - https://8.8.8.8/dns-query
  #    - https://dns.google/dns-query
  #    - https://dns.alidns.com/dns-query
  #    - https://doh.pub/dns-query # 腾讯 DoH
  # 配置 fallback 使用条件
  # fallback-filter:
  #   geoip: true # 配置是否使用 geoip
  #   geoip-code: CN # 当 nameserver 域名的 IP 查询 geoip 库为 CN 时，不使用 fallback 中的 DNS 查询结果
  #   配置强制 fallback，优先于 IP 判断，具体分类自行查看 geosite 库
  #   geosite:
  #     - gfw
  #   如果不匹配 ipcidr 则使用 nameservers 中的结果
  #   ipcidr:
  #     - 240.0.0.0/4
  #   domain:
  #     - '+.google.com'
  #     - '+.facebook.com'
  #     - '+.youtube.com'

  # 配置查询域名使用的 DNS 服务器
  nameserver-policy:
    "geosite:!cn":
      - tls://1.1.1.1:853
      - tls://8.8.8.8:853
      - https://cloudflare-dns.com/dns-query
      - https://dns.google/dns-query
    #   'www.baidu.com': '114.114.114.114'
    #   '+.internal.crop.com': '10.0.0.1'
#    "geosite:cn,private,apple":
#      - https://doh.pub/dns-query
#      - https://dns.alidns.com/dns-query
#    "geosite:category-ads-all": rcode://success
#    "www.baidu.com,+.google.cn": [223.5.5.5, https://dns.alidns.com/dns-query]

#以下规则按照下面顺序要插入合适的位置
rules:
  - GEOSITE,geolocation-!cn@cn,DIRECT # DIRECT 为直连分组，可以改为你自己的分组
  - GEOSITE,geolocation-!cn,🚀 节点选择 # 🚀 节点选择 为代理分组，可以改为你自己的分组
  - GEOSITE,geolocation-cn@!cn,🚀 节点选择
  - GEOSITE,geolocation-cn,DIRECT
  - GEOSITE,tld-cn,DIRECT #所有以 .cn 为后缀的域名


